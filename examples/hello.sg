print("=== SURGE INTEGRATION TEST ===")

print("Testing variables")
name = "Surge"
age = 20
enabled = true
disabled = false

print(name)
print(age)
print(enabled)
print(disabled)

print("Testing arithmetic")
a = 10
b = 3

print(a + b)
print(a - b)
print(a * b)
print(a / b)

print("Testing comparisons")
print(a == 10)
print(a != b)
print(a < b)
print(a <= 10)
print(a > b)
print(a >= 10)

print("Testing logical operators")
print(true and true)
print(true and false)
print(false or true)
print(false or false)
print(not true)
print(not false)

print("Testing precedence")
if true or false and false
    print("OR precedence works")

if true and not false
    print("AND and NOT precedence works")

print("Testing if")
if age >= 18
    print("Adult")

print("Testing if else")
age = 15

if age >= 18
    print("Adult")
else
    print("Minor")

print("Testing else if")
age = 16

if age >= 18
    print("Adult")
else if age >= 13
    print("Teenager")
else
    print("Child")

print("Testing while")
count = 0

while count < 5
    print(count)
    count = count + 1

print("Testing nested control flow")
number = 0

while number < 5
    if number < 3
        print(number)
    else
        print(100 + number)

    number = number + 1

print("Testing reassignment")
value = 10
print(value)

value = 20
print(value)

value = value + 5
print(value)

print("=== TEST COMPLETE ===")    count = count + 1   