print("Testing if")

age = 20

if age >= 18
    print("Adult")

print("Testing if else")

age = 15

if age >= 18
    print("Adult")
else
    print("Minor")

print("Testing else if")

age = 16

if age >= 18
    print("Adult")
else if age >= 13
    print("Teenager")
else
    print("Child")

print("Testing else")

age = 8

if age >= 18
    print("Adult")
else if age >= 13
    print("Teenager")
else
    print("Child")